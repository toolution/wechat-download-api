# WeChat Download API 配置文件
# 复制为 .env 后使用: cp env.example .env

# 认证信息 (登录后自动填充，无需手动配置)
WECHAT_TOKEN=
WECHAT_COOKIE=
WECHAT_FAKEID=
WECHAT_NICKNAME=
WECHAT_EXPIRE_TIME=

# 限频配置 (单位: 次/分钟 或 秒)
RATE_LIMIT_GLOBAL=10
RATE_LIMIT_PER_IP=5
RATE_LIMIT_ARTICLE_INTERVAL=3

# Webhook 通知 (留空则禁用，支持企业微信群机器人)
WEBHOOK_URL=
# 同一事件通知最小间隔（秒），防止重复轰炸
WEBHOOK_NOTIFICATION_INTERVAL=300

# RSS 订阅配置
# 轮询间隔（秒），默认 3600（1 小时）
RSS_POLL_INTERVAL=3600
# 每次轮询拉取的文章批次数，默认 10（高频更新的公众号可适当增大）
ARTICLES_PER_POLL=10
# RSS 轮询时是否获取完整文章内容（true/false），默认 true
# ⚠️ 启用时强烈建议配置下方的 PROXY_URLS，避免账号被微信风控
RSS_FETCH_FULL_CONTENT=true

# SOCKS5 代理池（⚠️ 启用RSS完整内容时强烈建议配置，避免账号风控）
# 用途：分散请求 IP，配合 Chrome TLS 指纹模拟，有效规避微信封控
# 不配置代理直连微信可能导致：频繁验证、账号限制、IP 封禁
# 支持 SOCKS5 代理，多个用逗号分隔，建议 2-3 个即可
# 示例: socks5://ip1:1080,socks5://ip2:1080,socks5://user:pass@ip3:1080
# 留空则直连（仅适用于少量订阅或禁用 RSS_FETCH_FULL_CONTENT 的情况）
PROXY_URLS=

# 服务配置
# 网站URL(用于RSS图片代理,必须配置为实际访问地址)
# 例如: http://你的IP:5000 或 https://你的域名.com
SITE_URL=http://localhost:5000
PORT=5000
HOST=0.0.0.0
DEBUG=false

# 数据库路径（默认 ./data/rss.db，Docker 环境一般无需修改）
# RSS_DB_PATH=/app/data/rss.db

# ===== 全站访问控制（公网部署强烈建议设置，可选）=====
# 本项目默认无访客鉴权，部署到 Zeabur 等公网后知道 URL 的人都能用，
# 且所有请求消耗的是你自己的微信登录态。两种方式可单独或同时启用，都留空则不启用：
#
# ① 登录页（浏览器使用）：设置后访问任何页面先跳 /signin 登录，成功后 30 天免登。
#    修改密码会使所有已登录 Cookie 失效（全员踢下线）。
ADMIN_USERNAME=
ADMIN_PASSWORD=
#
# ② API_TOKEN（脚本 / RSS 阅读器用）：
#    - 脚本/API 调用: 请求头 Authorization: Bearer <API_TOKEN>
#    - RSS 阅读器: 订阅链接后加 ?token=<API_TOKEN>
#    建议只用字母数字（避免 Cookie/URL 特殊字符问题）。
API_TOKEN=

# ===== MCP（AI 客户端接入，可选）=====
# 开启后 Claude/Codex/Cline 等 AI 客户端可直接搜索/订阅/读你的公众号文章。
# ENABLE_MCP=1 且设置 MCP_TOKEN 才启用；客户端需配 Authorization: Bearer <MCP_TOKEN>。
ENABLE_MCP=0
MCP_TOKEN=
# MCP 资源 URL（部署域名，用于 DNS-rebinding 白名单；默认 localhost）
# MCP_RESOURCE_URL=https://你的域名/mcp
